PORT=3000
SESSION_SECRET=change-me

# Застосунок ходить у БД від ролі app_user (без прав на зміну схеми)
DATABASE_URL=postgres://app_user:app_pass@localhost:5432/myproject
# Міграції та імпорт даних виконуються від postgres
DATABASE_MIGRATOR_URL=postgres://postgres:postgres@localhost:5432/myproject

# Джерело даних для `npm run db:import-mysql` (стара MySQL-база novashop)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASS=root
MYSQL_DB=novashop

# Пошта (необов'язково)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NovaShop
